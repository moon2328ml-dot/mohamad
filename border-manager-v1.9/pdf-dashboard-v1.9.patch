+    private val reportColumnWidths = floatArrayOf(67f, 69f, 94f, 46f, 62f, 81f, 108f)
+
+    private fun drawReportTableHeader(canvas: android.graphics.Canvas, y: Float, ownerIndex: Int): Float {
+        val (bg, fg) = ownerPalette[ownerIndex % ownerPalette.size]
+        val h = 29f
+        var right = PAGE_W - MARGIN
+        val labels = listOf("پلاک", "نوع بار", "مشخصات ماشین", "نوبت", "کوتاژ", "وضعیت", "گمرک")
+        labels.forEachIndexed { i, label ->
+            val w = reportColumnWidths[i]
+            val left = right - w
+            canvas.drawRect(left, y, right, y + h, Paint(Paint.ANTI_ALIAS_FLAG).apply { color = bg })
+            drawCellText(canvas, label, left + 2f, y + 7f, w - 4f, 8f, true, fg, 1)
+            canvas.drawLine(left, y, left, y + h, Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.argb(70, 80, 70, 110); strokeWidth = .7f })
+            right = left
+        }
+        canvas.drawRect(MARGIN, y, PAGE_W - MARGIN, y + h, Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.STROKE; color = Color.rgb(222, 218, 231); strokeWidth = .8f })
+        return y + h
+    }
+
+    private fun drawReportTableRow(
+        canvas: android.graphics.Canvas, y: Float, t: Truck, statusText: String, status: CargoStatus,
+        disposition: CargoDisposition, cottage: String, customs: String, ownerIndex: Int, rowIndex: Int
+    ): Float {
+        val h = 57f
+        val ownerBg = ownerPalette[ownerIndex % ownerPalette.size].first
+        val rowBg = if (rowIndex % 2 == 0) Color.WHITE else blendColor(ownerBg, Color.WHITE, .58f)
+        canvas.drawRect(MARGIN, y, PAGE_W - MARGIN, y + h, Paint(Paint.ANTI_ALIAS_FLAG).apply { color = rowBg })
+        val part = if (t.partTitle.isNotBlank()) "\nپارت ${t.partTitle}" else ""
+        val values = listOf(
+            t.plate,
+            t.cargoTitle + part,
+            "${Formatters.weightKg(t.weightKg)}\nسایز ${t.size.ifBlank { "-" }} • بندل ${Formatters.number(t.bundleCount)}",
+            if (t.parkingQueue > 0) Formatters.number(t.parkingQueue) else "-",
+            cottage, statusText, customs
+        )
+        val (statusBg, statusFg) = statusColors(status, disposition)
+        var right = PAGE_W - MARGIN
+        values.forEachIndexed { i, value ->
+            val w = reportColumnWidths[i]
+            val left = right - w
+            if (i == 5) canvas.drawRoundRect(RectF(left + 3f, y + 5f, right - 3f, y + h - 5f), 8f, 8f, Paint(Paint.ANTI_ALIAS_FLAG).apply { color = statusBg })
+            if (i == 6) {
+                drawCustomsCell(canvas, value, left, y, w, h)
+            } else {
+                drawCellText(canvas, value, left + 3f, y + 8f, w - 6f, if (i == 2) 7f else 7.7f, i == 0 || i == 5, if (i == 5) statusFg else Color.rgb(35, 31, 52), if (i == 2) 3 else 2)
+            }
+            canvas.drawLine(left, y, left, y + h, Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.rgb(225, 222, 233); strokeWidth = .65f })
+            right = left
+        }
+        canvas.drawRect(MARGIN, y, PAGE_W - MARGIN, y + h, Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.STROKE; color = Color.rgb(225, 222, 233); strokeWidth = .8f })
+        return y + h
+    }
+
+    private fun drawCustomsCell(canvas: android.graphics.Canvas, text: String, left: Float, top: Float, width: Float, height: Float) {
+        val lines = text.split("\n")
+        if (lines.size < 2) {
+            drawCellText(canvas, text, left + 3f, top + 8f, width - 6f, 7f, true, Color.rgb(35, 31, 52), 2)
+            return
+        }
+        lines.take(2).forEachIndexed { index, raw ->
+            val ok = raw.contains("✓")
+            val label = raw.replace("✓", "").replace("✕", "").trim()
+            val bg = if (ok) Color.rgb(224, 246, 231) else Color.rgb(255, 231, 234)
+            val fg = if (ok) Color.rgb(22, 126, 67) else Color.rgb(185, 43, 56)
+            val pillTop = top + 5f + index * 25f
+            canvas.drawRoundRect(RectF(left + 4f, pillTop, left + width - 4f, pillTop + 20f), 7f, 7f, Paint(Paint.ANTI_ALIAS_FLAG).apply { color = bg })
+            drawCellText(canvas, label, left + 6f, pillTop + 5f, width - 12f, 6.7f, true, fg, 1)
+        }
+    }
+
+    private fun drawCellText(canvas: android.graphics.Canvas, text: String, left: Float, top: Float, width: Float, size: Float, bold: Boolean, color: Int, maxLines: Int) {
+        val paint = TextPaint(Paint.ANTI_ALIAS_FLAG).apply {
+            this.color = color; textSize = size
+            typeface = if (bold) Typeface.create(reportTypeface, Typeface.BOLD) else reportTypeface
+        }
+        val layout = StaticLayout.Builder.obtain(text, 0, text.length, paint, width.toInt().coerceAtLeast(1))
+            .setAlignment(Layout.Alignment.ALIGN_CENTER)
+            .setTextDirection(TextDirectionHeuristics.RTL)
+            .setMaxLines(maxLines)
+            .setLineSpacing(0f, 1.02f)
+            .build()
+        canvas.save(); canvas.translate(left, top); layout.draw(canvas); canvas.restore()
+    }
+
+    private fun blendColor(a: Int, b: Int, bWeight: Float): Int {
+        val aw = 1f - bWeight
+        return Color.rgb(
+            (Color.red(a) * aw + Color.red(b) * bWeight).toInt(),
+            (Color.green(a) * aw + Color.green(b) * bWeight).toInt(),
+            (Color.blue(a) * aw + Color.blue(b) * bWeight).toInt()
+        )
+    }
